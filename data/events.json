        "failure": {
          "text": "»Das sind keine Schuhe, das sind Erinnerungen an Schuhe.« Es schubst dich.",
          "effects": [
            {
              "damage": 2
            }
          ]
        }
      },
      {
        "label": "Einfach vorbeigehen",
        "check": {
          "category": "kraftakt",
          "dc": 12
        },
        "success": {
          "text": "Du schiebst es freundlich zur Seite. Es fällt auseinander und flucht.",
          "effects": [
            {
              "gainXp": 3
            }
          ]
        },
        "failure": {
          "text": "Es baut sich auf. Also, es setzt sich zusammen. Dann greift es an.",
          "effects": [
            {
              "combat": "skeleton"
            },
            {
              "gainXp": 3
            }
          ]
        }
      }
    ]
  },
  {
    "id": "exit_souvenir",
    "type": "npc",
    "title": "Der Andenkenstand",
    "text": "Vor dem Abstieg hat ein Goblin einen Stand aufgebaut: Postkarten, Tassen und Schilde mit »Ich war im Dungeon«.",
    "options": [
      {
        "label": "Feilschen",
        "check": {
          "category": "diplomatie",
          "dc": 12
        },
        "success": {
          "text": "Er schenkt dir aus Mitleid eine Tasse. Darin liegen Münzen.",
          "effects": [
            {
              "loot": "tier1"
            },
            {
              "gainXp": 2
            }
          ]
        },
        "failure": {
          "text": "Du kaufst versehentlich fünf Postkarten. Sie zeigen alle diesen Raum. Bezahlt hast du mit einem Lächeln."
        }
      },
      {
        "label": "Weitergehen",
        "text": "»Komm wieder!«, ruft er. »Das tun alle!«"
      }
    ]
  },
