        }
      ]
    },
    "wache_kerze": {
      "figures": [
        {
          "figure": "goblin",
          "anchor": "am_tisch_sitzend"
        }
      ]
    },
    "wache_wuerfel": {
      "figures": [
        {
          "figure": "skeleton",
          "count": 2,
          "anchor": "am_tisch_sitzend",
          "variant": "warrior"
        }
      ]
    },
    "vorrat_ratte": {
      "figures": [
        {
          "figure": "rat",
          "anchor": "im_mehlsack"
        }
      ]
    },
    "schatz_mimik": {
      "figures": [
        {
          "figure": "mimic",
          "anchor": "mitten_im_raum"
        }
      ]
    },
    "exit_tuersteher": {
      "figures": [
        {
          "figure": "skeleton",
          "variant": "warrior",
          "anchor": "vor_der_treppe"
        }
      ]
    },
    "kueche_chef": {
