{
  "_info": "Inszenierung der Event-Figuren (docs/GDD.md, Grafik und Animation, „Inszenierung der Figuren“): wo Figuren stehen, wohin sie blicken, welche Animation sie zeigen. Spielregeln, Texte und Ergebnisse stehen weiter in data/events.json. defaults: Standard ohne eigene Inszenierung; anchors: Anker an Requisiten (props, offset [x, y, z] in Kacheln gedreht wie das Requisit, face player|target|prop|random, animation idle|sit|sit_floor|lie|awaken, seat: sitzt auf dem Requisit, onProp: steht auf dem Requisit, world: Versatz ohne Drehung des Requisits, front: zuerst die Seite zur Kamera, flat: ohne Liege-Animation liegt die Figur starr auf dem Rücken statt zu stehen); figures: Modell-Varianten (variants, nach Raum-Seed), stays (bleibt nach dem Event stehen) und steps (eigene Schritte, Sound schritt_<steps>); events: eigene Inszenierung pro Event (figure, count, anchor, variant, stay: bleibt nach dem Event). Fehlt die Animation im Modell, steht die Figur mit idle neben dem Anker.",
  "defaults": {
    "place": "free",
    "face": "player",
    "animation": "idle",
    "countUnknown": [
      1,
      3
    ]
  },
  "anchors": {
    "am_tisch_sitzend": {
      "props": [
        "hocker",
        "stuhl",
        "tafel"
      ],
      "seat": true,
      "offset": [
        0,
        0,
        0
      ],
      "face": "target",
      "animation": "sit",
      "_": "Sitzt auf einem freien Hocker oder Stuhl, Blick zum Tisch; an der Tafel ohne Stuhl am Kopfende"
    },
    "am_herd": {
      "props": [
        "herd"
      ],
      "offset": [
        0,
        0,
        1
      ],
      "face": "player",
      "animation": "idle",
      "_": "Steht auf der Kachel vor dem Herd"
    },
    "am_sarkophag": {
      "props": [
        "sarkophag"
      ],
      "offset": [
        1,
        0,
        0
      ],
      "face": "player",
      "animation": "awaken",
      "_": "Neben dem Sarkophag; Skelette stehen beim Event-Start mit awaken auf (Skeletons_Awaken_Floor)"
    },
    "am_lagerfeuer": {
      "props": [
        "lagerfeuer"
      ],
      "offset": [
        1,
        0,
        0
      ],
      "face": "target",
      "animation": "sit_floor"
    },
    "zwischen_knochen_liegend": {
      "props": [
        "knochen"
      ],
      "offset": [
        0,
        0,
        0
      ],
      "face": "random",
      "animation": "lie",
      "_": "Liegt auf der Knochen-Kachel (Skeletons_Inactive_Floor_Pose), steht bei Kampfbeginn auf"
    },
    "auf_kaeseberg": {
      "props": [
        "kaeseberg"
      ],
      "offset": [
        0,
        0.9,
        0.1
      ],
      "face": "player",
      "animation": "idle",
      "onProp": true
    },
    "auf_dem_hocker_schlafend": {
      "props": [
        "hocker"
      ],
      "seat": true,
      "offset": [
        0,
        0,
        0
      ],
      "face": "random",
      "animation": "sit",
      "_": "Schlafende Wache; ohne Sitzen (Goblin) stehend neben dem Hocker"
    },
    "im_mehlsack": {
      "props": [
        "sack"
      ],
      "offset": [
        0,
        0,
        0.6
      ],
      "face": "player",
      "animation": "idle"
    },
    "vor_der_treppe": {
      "props": [
        "treppe_runter"
      ],
      "offset": [
        0,
        0,
        0
      ],
      "face": "player",
      "animation": "idle",
      "_": "Türsteher auf der Kachel vor der Treppe"
    },
    "mitten_im_raum": {
      "props": [
        "truhe"
      ],
      "offset": [
        0,
        0,
        0
      ],
      "face": "player",
      "animation": "idle",
      "_": "Mimik steht dort, wo sonst die Truhe steht"
    },
    "am_brunnen": {
      "props": [
        "brunnen"
      ],
      "offset": [
        0.26,
        0.62,
        0.26
      ],
      "onProp": true,
      "face": "player",
      "animation": "idle",
      "_": "Kröte sitzt auf dem Brunnenrand",
      "world": true
    },
    "neben_dem_tisch_liegend": {
      "props": [
        "tisch"
      ],
      "offset": [
        0,
        0,
        0
      ],
      "face": "prop",
      "animation": "lie",
      "flat": true,
      "_": "Liegt flach neben dem Tisch, Füße zum Tisch; ohne Liege-Animation (Goblin) liegt die Figur starr auf dem Rücken",
      "front": true
    }
  },
  "figures": {
    "skeleton": {
      "variants": [
        "minion",
        "warrior",
        "rogue",
        "mage"
      ],
      "default": "minion"
    },
    "kroete": {
      "stays": true
    },
    "haendlerfigur": {
      "stays": true
    },
    "rat": {
      "steps": "trippeln"
    },
    "kuechenratte": {
      "steps": "trippeln"
    },
    "monsterratte": {
      "steps": "trippeln"
    }
  },
  "events": {
